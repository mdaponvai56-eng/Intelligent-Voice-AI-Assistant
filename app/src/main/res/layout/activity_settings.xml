<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/api_key_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginBottom="16dp" />

            <!-- API Endpoint -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/api_endpoint_label"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/apiEndpointInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:inputType="textUri"
                android:background="@android:drawable/edit_text"
                android:padding="12dp"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

            <!-- API Key -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/api_key_label"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/apiKeyInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:inputType="textPassword"
                android:background="@android:drawable/edit_text"
                android:padding="12dp"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

            <!-- Model -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/api_model_label"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/modelInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:inputType="text"
                android:background="@android:drawable/edit_text"
                android:padding="12dp"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Save Button -->
    <Button
        android:id="@+id/saveButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/save_settings"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:background="@color/primary"
        android:layout_marginTop="16dp" />
</LinearLayout>
