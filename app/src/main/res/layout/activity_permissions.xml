<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/white">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/permissions_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/statusTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/permission_microphone"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:background="@color/gray_light" />

    <!-- Audio Permission -->
    <Button
        android:id="@+id/audioPermButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/permission_microphone"
        android:textSize="14sp"
        android:background="@color/primary"
        android:textColor="@color/white"
        android:layout_marginBottom="12dp" />

    <!-- Accessibility Permission -->
    <Button
        android:id="@+id/accessibilityPermButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/permission_accessibility"
        android:textSize="14sp"
        android:background="@color/secondary"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="12dp" />

    <!-- Screen Capture Permission -->
    <Button
        android:id="@+id/screenCaptureButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/permission_screen_capture"
        android:textSize="14sp"
        android:background="@color/primary_variant"
        android:textColor="@color/white" />
</LinearLayout>
